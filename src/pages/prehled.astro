---
import Shell from '../components/Shell.astro';
import sample from '../content/editions/sample.json';
import { publicEditionSchema } from '../lib/editions.mjs';
const editions = Object.entries(import.meta.glob('../content/editions/tyden-*.json', {eager:true, import:'default'}))
  .map(([path, data]) => {
    const edition = publicEditionSchema.parse(data);
    if (!path.endsWith('/' + edition.id + '.json')) throw new Error('Název vydání musí odpovídat stabilnímu ID.');
    return edition;
  }).sort((a,b) => b.windowStart.localeCompare(a.windowStart));
---
<Shell title="Pondělní přehled" active="news" breadcrumb="Pondělní přehled">
  <header class="page-intro"><p class="eyebrow">ZPRÁVY A VLASTNÍ EXPERIMENTY</p><h1>Pondělní přehled</h1><p>Co se stalo v uzavřeném týdnu, proč na tom záleží a co si můžeš sám vyzkoušet.</p></header>
  <div class="reading">
    <section class="panel content-card"><h2>Archiv</h2>
      {editions.length ? <ul>{editions.map((edition) => <li><a href={'#'+edition.id}>{edition.title}</a> · od {edition.windowStart}</li>)}</ul> : <p>Archiv zatím obsahuje pilot z příručky. Pracovní návrhy čekají na samostatnou kontrolu.</p>}
      <a class="text-link" href="#ukazka">Pilot · {sample.label} →</a>
    </section>
    {editions.map((edition) => <section class="panel content-card" id={edition.id}>
      <p class="eyebrow">Schválené vydání · týden od {edition.windowStart}</p><h2>{edition.title}</h2><p>{edition.intro}</p>
      {edition.items.map((item) => <div class="callout"><p>{item.summary}</p><p><strong>Proč na tom záleží.</strong> {item.why}</p><p>Oznámeno {item.announced || 'v neurčeném termínu'} · Dostupnost: {item.availability}</p><a href={item.url}>Primární zdroj ↗</a></div>)}
      <h3>Téma do hloubky</h3><p>{edition.deepDive}</p><h3>Zkus si</h3><p>{edition.experiment}</p>
      {edition.corrections.length > 0 && <><h3>Opravy</h3><ul>{edition.corrections.map((correction) => <li>{correction}</li>)}</ul></>}
    </section>)}
    <section class="panel content-card" id="ukazka">
      <p class="eyebrow">Pilot z příručky · {sample.label}</p><h2>{sample.title}</h2><p>{sample.intro}</p>
      <p class="callout">Pět minut textu a přibližně patnáct minut čtení a pokusu. Jde o převzatou studijní ukázku, stav produktů ověř v primárních odkazech.</p>
      {sample.items.map((item) => <article><h3>{item.title}</h3><p>{item.summary}</p><p class="subtle">Oznámení · {item.announced} | Dostupnost · {item.availability}</p><a class="text-link" href={item.url}>Primární zdroj ↗</a></article>)}
      <h3>Desetiminutový pokus</h3><p>{sample.experiment}</p><p><a href="https://artificialanalysis.ai/">Artificial Analysis ↗</a> · Prozkoumej metodiku grafu a porovnej ji s vlastními případy.</p>
    </section>
    <section class="panel content-card" id="sablona">
      <h2>Redakční šablona · 20 minut</h2>
      <ol><li><strong>2 min · Úvod.</strong> Vymez období a vyber tři stručná zjištění.</li><li><strong>7 min · Hlavní zprávy.</strong> Přidej primární zdroj, den oznámení, samostatně dostupnost a dopad.</li><li><strong>7 min · Do hloubky.</strong> Popiš mechanismus, důkazy, omezení a vlastní využití.</li><li><strong>4 min · Zkus si.</strong> Přidej úlohu s kritériem úspěchu a doporučené čtení.</li></ol>
      <p>Koncept má stabilní ID, čas sběru a stav „k revizi“. Pro výběr zvaž dopad (0–3), relevanci (0–3) a sílu důkazů (0–2). Redaktor otevře primární odkazy a ověří fakta i dostupnost před zařazením do archivu.</p>
      <details><summary>Jak vzniká návrh</summary><p>Pondělní plán je nastaven na 07:15 v Europe/Prague. Filtr začíná předchozí pondělí 00:00 včetně a končí aktuální pondělí 00:00 bez této hranice. Stejný interval lze spustit ručně. Návrh i zkušební data zůstávají v redakčním úložišti.</p></details>
    </section>
  </div>
</Shell>
