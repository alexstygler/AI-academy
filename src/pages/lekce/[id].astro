---
import { ArrowLeft, ArrowRight, Clock3 } from 'lucide-astro';
import Shell from '../../components/Shell.astro';
import Notebook from '../../components/Notebook.astro';
import Quiz from '../../components/Quiz.astro';
import Tutor from '../../components/Tutor.astro';
import { lessons, lessonUrl, url } from '../../lib/course';

export function getStaticPaths() {
  return lessons.map((lesson, index) => ({params:{id:lesson.id},props:{lesson, previous:lessons[index-1], next:lessons[index+1]}}));
}
const { lesson, previous, next } = Astro.props;
const prerequisites = lesson.prerequisites.map((id) => lessons.find((entry) => entry.id === id)).filter((entry) => entry !== undefined);
const workingWithSources = lesson.week <= 3 || [11,12,15].includes(lesson.week);
const toc = [['vyklad','Výklad'], ['priklad','Příklad'], ['vedene','Vedené cvičení'], ['overeni','Ověření'], ['samostatne','Samostatná práce'], ['tutor','Tutor'], ['zdroje','Zdroje']];
---
<Shell title={lesson.title} active="lessons" breadcrumb="Lekce">
  <header class="page-intro" data-current-lesson={lesson.id}>
    <a class="text-link" href={url('lekce')}><ArrowLeft size={15} /> Studijní plán</a>
    <div class="lesson-meta"><span class="status-tag">Týden {lesson.week}</span><span><Clock3 size={15} /> {lesson.minutes} min</span><span data-lesson-status role="status">Otevřeno</span></div>
    <h1>{lesson.title}</h1><p>{lesson.goal}</p><a class="text-link" href="#vedene">Přejít na cvičení ↓</a>
  </header>
  <div class="lesson-layout">
    <article>
      <section class="panel lesson-card" id="vyklad">
        <h2>Výklad</h2>
        <p><strong>Předpoklady</strong> {prerequisites.length ? <>Pomohou ti lekce {prerequisites.map((entry, index) => <>{index > 0 && ', '}<a href={lessonUrl(entry.id)}>{entry.title}</a></>)}.</> : 'Stačí prohlížeč a chvíle na první cvičení.'}</p>
        <p>{lesson.theory}</p><p>{lesson.detail}</p>
      </section>
      <section class="panel lesson-card" id="priklad">
        <h2>Příklad</h2>
        {workingWithSources && <p class="status-tag">Fiktivní výukové údaje</p>}
        <p>{lesson.example}</p>
        {lesson.code && <div class="code-box"><div class="code-head"><span>Ukázka</span><button type="button" data-copy>Kopírovat</button></div><pre><code>{lesson.code}</code></pre><p data-copy-status role="status"></p></div>}
      </section>
      <section class="panel lesson-card" id="vedene">
        <h2>Vedené cvičení</h2><p>{lesson.guided}</p>
        {workingWithSources && <p><a class="text-link" href={url('dilna') + '#prameny'}>Otevřít fiktivní prameny <ArrowRight size={15} /></a></p>}
        <details><summary>Zobrazit nápovědu</summary><p>{lesson.hint}</p></details>
      </section>
      <section class="panel lesson-card" id="overeni"><h2>Ověř si porozumění</h2><Quiz id={lesson.id} questions={lesson.questions} /></section>
      <section class="panel lesson-card" id="samostatne">
        <h2>Samostatná práce</h2><p>{lesson.independent}</p>
        <details><summary>Zobrazit vzor řešení</summary><p>{lesson.sample}</p></details>
        <Notebook id={lesson.id} rubric={lesson.rubric} />
      </section>
      <Tutor id={lesson.id} hint={lesson.hint} example={lesson.example} check={lesson.questions[0]!.prompt} />
      <section class="panel lesson-card" id="zdroje"><h2>Zdroje</h2><p>Studijní příručka <cite>AI akademie pro Alexe</cite> · {lesson.sourceChapter}, s. {lesson.sourcePage}.</p><ul>{lesson.sources.map((source) => <li><a href={source.url}>{source.label}</a></li>)}</ul></section>
      <nav class="pager" aria-label="Sousední lekce">
        <a class="button secondary" href={previous ? lessonUrl(previous.id) : url('lekce')}><ArrowLeft size={16} /> {previous ? 'Předchozí lekce' : 'Studijní plán'}</a>
        <a class="button" href={next ? lessonUrl(next.id) : url('dilna') + '#zkouska'}>{next ? 'Další lekce' : 'Zkouška přenosu'} <ArrowRight size={16} /></a>
      </nav>
    </article>
    <aside class="lesson-aside"><section class="panel study-panel"><h2>V této lekci</h2><nav aria-label="Obsah lekce">{toc.map(([id,label]) => <a href={`#${id}`}>{label}</a>)}</nav></section><section class="panel study-panel"><h2>Můj pokrok</h2><p>Ověření se uloží po správném odevzdání všech odpovědí.</p><a href={url('pokrok')}>Správa pokroku →</a></section></aside>
  </div>
  <script>
    import { readProgress, updateRecord, progressMessage, progressEvent } from '../../lib/progress';
    const id = document.querySelector<HTMLElement>('[data-current-lesson]')!.dataset.currentLesson!;
    updateRecord(id, (record) => { record.opened = true; });
    const showState = () => {
      const state = readProgress();
      document.querySelector('[data-lesson-status]')!.textContent = state.problem ? progressMessage(state.problem) : state.data.lessons[id]?.completed ? 'Splněno' : 'Otevřeno';
    };
    showState();
    document.addEventListener(progressEvent, showState);
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
      button.addEventListener('click', async () => {
        const box = button.closest('.code-box')!;
        const status = box.querySelector('[data-copy-status]')!;
        try { await navigator.clipboard.writeText(box.querySelector('code')!.textContent!); status.textContent = 'Zkopírováno.'; }
        catch { status.textContent = 'Kopírování se nezdařilo. Text můžeš označit ručně.'; }
      });
    }
  </script>
</Shell>
