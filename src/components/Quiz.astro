---
type Item = { id: string; prompt: string; answer: number; options: { text: string; feedback: string }[] };
interface Props { id: string; questions: Item[]; label?: string; }
const {id, questions, label = 'Odevzdat odpovědi'} = Astro.props;
---
<form method="dialog" data-quiz={id}>
  <script is:inline type="application/json" set:html={JSON.stringify(questions).replace(/</g, '\\u003c')}></script>
  {questions.map((item) => <fieldset>
    <legend>{item.prompt}</legend>
    {item.options.map((option, index) => <label class="option"><input type="radio" name={item.id} value={index} required /><span>{option.text}</span></label>)}
    <p hidden class="quiz-feedback" data-feedback={item.id}></p>
  </fieldset>)}
  <button class="button" type="submit">{label}</button>
  <p class="field-status" role="status" data-quiz-status></p>
</form>
<script>
  import { grade } from '../lib/quiz.mjs';
  import { readProgress, updateRecord, progressMessage } from '../lib/progress';
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-quiz]')) {
    const id = form.dataset.quiz!;
    const questions = JSON.parse(form.querySelector('script')!.textContent!);
    const status = form.querySelector<HTMLElement>('[data-quiz-status]')!;
    const feedback = new Map([...form.querySelectorAll<HTMLElement>('[data-feedback]')].map((item) => [item.dataset.feedback, item]));
    const paint = (result: ReturnType<typeof grade>, saved: boolean) => {
      for (const item of result.results) {
        const element = feedback.get(item.id)!;
        element.hidden = false;
        element.classList.toggle('good', item.correct);
        element.classList.toggle('bad', !item.correct);
        element.textContent = (item.correct ? 'Správně. ' : 'Zkus znovu. ') + item.feedback;
      }
      status.textContent = (saved ? 'Poslední uložený pokus. ' : '') + `${result.score} z ${result.total}. ${result.score === result.total ? 'Ověření splněno.' : 'Pročti vysvětlení a zkus další pokus.'}`;
    };
    const last = readProgress().data.lessons[id]?.attempts.at(-1);
    if (last) {
      for (const input of form.querySelectorAll<HTMLInputElement>('input[type=radio]')) input.checked = Number(input.value) === last.answers[input.name];
      try { paint(grade(questions, last.answers), true); } catch { /* Nová revize může obsahovat jiné otázky. */ }
    }
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const answers = Object.fromEntries([...new FormData(form)].map(([key, value]) => [key, Number(value)]));
      const result = grade(questions, answers);
      paint(result, false);
      const problem = updateRecord(id, (record) => {
        record.opened = true;
        record.completed ||= result.score === result.total;
        record.attempts = [...record.attempts.slice(-99), { at: new Date().toISOString(), score: result.score, total: result.total, answers }];
      });
      if (problem) status.textContent += ' ' + progressMessage(problem);
      else document.dispatchEvent(new Event('academy-progress'));
    });
  }
</script>
